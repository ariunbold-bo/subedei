NODE_ENV=development
# Overrides api.port from erxes.json (3399).
# PORT=

# ---- Database --------------------------------------------------------------
MONGO_URL=mongodb://127.0.0.1:27017/subedei
# true = throwaway in-memory MongoDB (no install needed; downloads mongod once).
# MONGO_MEMORY=false

# ---- School ----------------------------------------------------------------
SCHOOL_NAME=Жишээ сургууль
TIMEZONE=Asia/Ulaanbaatar
# Seconds a call rings before the next guardian is called.
RING_TIMEOUT_SEC=25
# Seconds to wait for the guardian's spoken reply after answering.
REPLY_TIMEOUT_SEC=90
# Minutes after the class pickup time before automatic late-pickup calls.
PICKUP_GRACE_MIN=10
AUTO_PICKUP_CALLS=true

# ---- AI model (any OpenAI-compatible endpoint) ------------------------------
# Gemma 4, local:        ollama pull gemma4  ->  http://localhost:11434/v1
# Gemma 4, DigitalOcean: GPU Droplet with Ollama/vLLM -> http://<droplet-ip>:11434/v1
# oyuLLM (Mongolian):    LLM_BASE_URL=https://api.oyu.so/v1  LLM_MODEL=oyuLLM  LLM_API_KEY=<oyu key>
LLM_ENABLED=true
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=gemma4
# LLM_API_KEY=
LLM_TIMEOUT_MS=20000

# ---- Oyu speech: tsuurAI TTS + Anir STT (https://dev.oyu.so) ------------------
# Key from https://oyu.so/account/apikeys. Unset = browser Web Speech API.
# OYU_API_KEY=
# OYU_BASE_URL=https://api.oyu.so/v1
# female | mbspeech (male)
OYU_VOICE=female
# Anir model, e.g. v4 (unset = Oyu default)
# OYU_STT_MODEL=

# ---- Phone calls -----------------------------------------------------------
# simulator = browser phone (demo); auto = Twilio when fully configured.
CALL_PROVIDER=simulator
# Twilio (needs an upgraded account; see README "Жинхэнэ утас руу залгах").
# PUBLIC_URL=
# TWILIO_ACCOUNT_SID=
# TWILIO_API_KEY=
# TWILIO_API_SECRET=
# TWILIO_PHONE_NUMBER=
# TWILIO_TRIAL=false

# ---- SMS gateway -----------------------------------------------------------
# Unset = simulator (messages appear on /phone.html).
# SMS_HTTP_URL=
# SMS_HTTP_TOKEN=
# SMS_SENDER=
# Transliterate Cyrillic to Latin before sending.
SMS_LATIN=false

# ---- erxes -----------------------------------------------------------------
# true = join the erxes gateway (Redis) and sync guardians into erxes Contacts.
ERXES_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=
ERXES_SUBDOMAIN=localhost
# An active erxes user id: call/SMS notes are written to the customer timeline.
# ERXES_USER_ID=
# Where the browser loads the UI remote from. Unset = plugins.erxes.io/<release>/subedei_ui/.
UI_ENTRY_URL=http://localhost:3099/remoteEntry.js
# Address the gateway uses to reach this API. Unset = localhost (dev) or plugin-subedei-api (prod).
# LOAD_BALANCER_ADDRESS=
# Release folder on plugins.erxes.io when it starts with "3."; otherwise "latest".
# RELEASE_VERSION=
